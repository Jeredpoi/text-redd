{
  "name": "litera",
  "productName": "Литера",
  "version": "1.2.0",
  "description": "Текстовый редактор с богатым форматированием и проверкой орфографии (RU/EN)",
  "main": "main.js",
  "author": "Максим",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis-web",
    "release": "electron-builder --win nsis-web --publish always",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "html-to-docx": "^1.8.0",
    "mammoth": "^1.7.2",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.maxim.litera",
    "productName": "Литера",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist_installer",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Литера",
      "language": "1049"
    },
    "nsisWeb": {
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jeredpoi",
        "repo": "text-redd"
      }
    ]
  }
}
